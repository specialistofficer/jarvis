# Dashboard (Vite proxies /api to the local Worker by default)
VITE_API_BASE_URL=

# Worker local secrets: copy these entries to apps/worker/.dev.vars
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_FREE_ALLOWANCE_REMAINING=false
DEV_TRIGGER_TOKEN=replace-with-a-local-only-token
FOUNDER_EMAIL_SECRET=
FOUNDER_PASSWORD_HASH=
SESSION_SIGNING_SECRET=

# Jarvis never spends automatically. These values are intentionally immutable in V1.
ALLOW_PAID_SPEND=false
MAX_COST_INR=0
