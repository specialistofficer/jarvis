# Environment Settings
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./client_agent.db

# Security & Founder Auth
FOUNDER_EMAIL=founder@example.com
API_SECRET_TOKEN=change-me-to-a-secure-random-token

# AI Providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Telegram Notification Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Application Limits & Safety
ALLOW_PAID_SPEND=false
MAX_COST_INR=0
DEFAULT_APPLICATION_MODE=APPROVAL_REQUIRED
DAILY_APPLICATION_LIMIT=10
AUTO_APPLY_ENABLED=false
